[sub_resource type="Resource" id="Resource_qyvwp"]
script = ExtResource("2")
stream = ExtResource("3")
dialogue_text = "YOU MAY BE WONDERING WHY THE REGISTER IS NOW GLOWING A BRIGHT PURPLE. SPEAKING OF WHICH!"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_x4gtv"]
script = ExtResource("2")
stream = ExtResource("4")
dialogue_text = "CONGRATULATIONS ON THE SOULTOKEN! MUEAHEHAHAHAHAHA!"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_sqrd4"]
script = ExtResource("2")
stream = ExtResource("5")
dialogue_text = "AS YOU BEAT MY CARTRIDGES AND HAND THEIR RESPECTIVE ARTIFACTS TO ME, THE CONSOLE WILL REWARD YOUR HARD WORK WITH A SOULTOKEN."
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_lmj7a"]
script = ExtResource("2")
stream = ExtResource("6")
dialogue_text = "WHEN YOU HAVE ONE AND SEE THE REGISTER [u]GLOW[/u], JUST POINT TO ME FIRST, AND THEN AT THE SHOP ON THE SIGN. IT MEANS I HAVE SOMETHING READY JUST FOR YOU.
"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_0e46f"]
script = ExtResource("2")
stream = ExtResource("7")
dialogue_text = "MIND YOU NOW, THE CONSOLE ONLY GIVES A SOULTOKEN FOR BEATING EXPERIENCES FOR THE FIRST. TIME. ONLY."
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_sqtra"]
script = ExtResource("2")
stream = ExtResource("8")
dialogue_text = "THAT’S IT, THAT’S HOW IT WORKS, NO ASKING ME FOR MORE SOULTOKENS. OFF YOU GO NOW!

"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

