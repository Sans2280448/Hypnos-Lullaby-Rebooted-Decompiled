[sub_resource type="Resource" id="Resource_sqsb5"]
script = ExtResource("2")
stream = ExtResource("3")
dialogue_text = "OKAY, AHEM. FIRST OF ALL? THEY'RE NOT RAP BATTLES."
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_bet6j"]
script = ExtResource("2")
stream = ExtResource("4")
dialogue_text = "THEY'RE MUSICAL BATTLES FOR SOULS, AND WHAT THEY HOLD DEAREST TO THEIR HEARTS! AFTER ALL, ISN'T MUSIC THE WINDOW INTO THE SOUL?"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_i7nn1"]
script = ExtResource("2")
stream = ExtResource("5")
dialogue_text = "WHETHER THEIR REPRESENTATIVE SONG IS POP-Y, MORE ROCK-Y, HEAVY METAL-Y, YADA YADA YADA-Y, EACH SONG IS AN INTIMATE WINDOW INTO WHAT MAKES THAT SOUL, A SOUL!"
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

[sub_resource type="Resource" id="Resource_6duev"]
script = ExtResource("2")
stream = ExtResource("6")
dialogue_text = "WHETHER IT'S MOMENTS BEFORE DEATH, A CONFESSION, OR A TRAGIC EVENT, THAT'S THE TIME WHEN THE SOUL'S MOST VULNERABLE, AND READY TO BE WRUNG DRY OF ITS JUICY JUICY ARTIFACTS."
state = 3
ending_state = 3
metadata/_custom_type_script = "uid://db05q0i1q5mr7"

