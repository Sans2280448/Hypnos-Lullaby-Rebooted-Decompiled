[gd_resource type="Shader" format=3 uid="uid://cmnexds2r1xvh"]

[resource]
code = "shader_type canvas_item;

uniform float saturation : hint_range(0.0, 1.0, 0.01) = 1.0;

void fragment() {
	float alpha = COLOR.a;
	vec4 tex_color = texture(TEXTURE, UV);
	float luminance = dot(
		tex_color.rgb,
		vec3(0.299, 0.587, 0.114)
	);

	COLOR.rgb = mix(
		vec3(luminance),
		tex_color.rgb,
		saturation
	);

	COLOR.a = tex_color.a * alpha;
}"
