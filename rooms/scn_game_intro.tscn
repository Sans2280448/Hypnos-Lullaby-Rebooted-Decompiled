[sub_resource type="GDScript" id="GDScript_fgqvd"]
resource_name = "mystery"
script/source = "extends Button

@export var poopy_logo: Sprite2D
@export var regular_logo: Sprite2D
@export var poopy_sound: AudioStreamPlayer

func _ready() -> void:
	pressed.connect(magic)

func magic() -> void:
	poopy_logo.visible = true
	regular_logo.self_modulate.a = 0
	poopy_sound.play()
	visible = false
"

