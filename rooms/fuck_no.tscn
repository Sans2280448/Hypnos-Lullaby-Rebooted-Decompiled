[sub_resource type="GDScript" id="GDScript_0kdkt"]
script/source = "extends Node

func _animation_finished(anim_name: StringName) -> void:
	if anim_name != &\"FuckNoHello\":
		return
	
	SaveData.set_flag(&\"fuckno_seen\", true)
	get_tree().change_scene_to_file(\"uid://dc0evbxs8l1vs\")
"

